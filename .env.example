DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/smartdialer
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:your_password@localhost:5432/smartdialer
SECRET_KEY=your-secret-key-here
ENVIRONMENT=development
LOG_LEVEL=INFO
WORKER_ID=worker-1
LEASE_DURATION_SECONDS=30
MAX_RETRY_ATTEMPTS=3
PROVIDER_TIMEOUT_SECONDS=10
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
